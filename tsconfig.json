{
	"compilerOptions": {
		"target": "es2023",
		"module": "preserve",
		"moduleResolution": "bundler",
		"lib": ["es2023"],
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src", "flue.config.ts"]
}
