# Copy to .env and fill in real values. Never commit secrets.

# --- Jira Cloud / Jira Service Management ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@your-org.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_JQL=project = SUPPORT AND statusCategory != Done AND assignee is not EMPTY ORDER BY priority DESC, updated ASC
JIRA_FIRST_RESPONSE_SLA_NAME=Time To First Response
# JIRA_PAGE_SIZE=50
# JIRA_MAX_RESULTS=500
# JIRA_MAX_SEARCH_PAGES=100
# JIRA_SLA_PAGE_SIZE=50
# JIRA_MAX_SLA_PAGES=10
# JIRA_SLA_CONCURRENCY=5

# --- Reminder delivery ---
# Workflow runs every 15 min; one delivery window opens every 60 min per breach.
# REMINDER_REPEAT_MINUTES=60
# REMINDER_DELIVERY_WINDOW_MINUTES=15
# REMINDER_DRY_RUN=false
# TEAMS_MAX_MESSAGE_CHARS=12000

# --- Microsoft Teams channel webhook ---
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/...

# --- Optional one-line intro: Gemini on Vertex AI ---
# The model receives aggregate counts only. Set false for fully deterministic output.
# REMINDER_USE_LLM_INTRO=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
# Local development only: use ADC or an ignored service-account key.
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa.json

# --- External request policy ---
# HTTP_TIMEOUT_MS=10000
# HTTP_MAX_RETRIES=2
