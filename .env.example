# Copy to .env and fill in real values. Never commit secrets.

# --- Jira Cloud / Jira Service Management ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@your-org.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_JQL=project = SUPPORT AND statusCategory != Done AND assignee is not EMPTY ORDER BY priority DESC, updated ASC
JIRA_FIRST_RESPONSE_SLA_NAME=Time To First Response
# The metric that drives the L2-L5 escalation clock in docs/sla-matrix.md.
JIRA_RESOLUTION_SLA_NAME=Time to resolution
# JIRA_PAGE_SIZE=50
# JIRA_MAX_RESULTS=500
# JIRA_MAX_SEARCH_PAGES=100
# JIRA_SLA_PAGE_SIZE=50
# JIRA_MAX_SLA_PAGES=10
# JIRA_SLA_CONCURRENCY=5

# --- Reminder delivery ---
# Workflow runs every 15 min; one delivery window opens every 60 min per breach.
# REMINDER_REPEAT_MINUTES=60
# REMINDER_DELIVERY_WINDOW_MINUTES=15
# REMINDER_DRY_RUN=false
# TEAMS_MAX_MESSAGE_CHARS=12000

# --- Microsoft Teams: channel webhook (optional) ---
# The aggregated channel post. Leave unset to run bot-only.
# At least one transport must be configured outside dry-run.
# TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/...

# --- Microsoft Teams: personal bot (optional) ---
# Setting both of these turns on direct messages and contract escalation.
# TEAMS_BOT_APP_ID is the Entra application id of the bot's app registration;
# it is also the manifest id of the Teams app package.
# TEAMS_BOT_APP_ID=00000000-0000-0000-0000-000000000000
TEAMS_BOT_TENANT_ID=376a710f-b223-451f-ba55-efc974d8716c

# Local development only. In GitHub Actions the token comes from the OIDC
# federated credential on the app registration, so leave this unset there.
# TEAMS_BOT_APP_PASSWORD=your-entra-client-secret

# Delivery follows the path already in production in this tenant (goOrange):
# Graph installs the app for the recipient and returns their personal chat id,
# then the Bot Connector posts one activity into that chat. Graph therefore
# needs TeamsAppInstallation.ReadWriteForUser.All, AppCatalog.Read.All and, for
# `npm run resolve:ids`, User.Read.All — application permissions, admin consent.
#
# Graph credentials default to the bot's own registration. Override only if
# Graph lives on a separate app registration.
# GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# GRAPH_CLIENT_SECRET=your-graph-client-secret
#
# The manifest id of the published package, matched in the catalog as
# externalId. Defaults to TEAMS_BOT_APP_ID.
# TEAMS_APP_EXTERNAL_ID=00000000-0000-0000-0000-000000000000
#
# Bot Connector endpoint for the tenant's Teams region. The default is the value
# goOrange uses in production here.
# TEAMS_BOT_SERVICE_URL=https://smba.trafficmanager.net/teams

# --- Escalation directory and state ---
# Who each contractual level is, per docs/sla-matrix.md section 2. Copy
# config/escalation.example.json, fill in email and jiraAccountId, then run
# `npm run resolve:ids` to fill in the object ids.
# ESCALATION_CONFIG_FILE=config/escalation.json
# ESCALATION_STATE_FILE=.escalation-state/state.json

# Staged rollout gate. While set, nobody outside this list can be messaged,
# whatever the directory says. Entries are matched against the directory by
# email, directory handle, or object id, and an entry that matches nobody is an
# error rather than a gate that quietly delivers nothing. Withheld levels are
# not recorded, so they are delivered once the gate opens.
# TEAMS_BOT_RECIPIENT_ALLOWLIST=anar@zerotech.mn,tergel@zerotech.mn

# One-time rollout step: record every level already crossed and notify nobody,
# so switching the bot on does not deliver the whole backlog at once.
# ESCALATION_SEED_ONLY=false

# --- Optional one-line intro: Gemini on Vertex AI ---
# The model receives aggregate counts only. Set false for fully deterministic output.
# REMINDER_USE_LLM_INTRO=false
# Deadline for the intro call only, independent of HTTP_TIMEOUT_MS.
# REMINDER_INTRO_TIMEOUT_MS=10000
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
# Local development only: use ADC or an ignored service-account key.
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa.json

# --- External request policy ---
# HTTP_TIMEOUT_MS=10000
# HTTP_MAX_RETRIES=2
