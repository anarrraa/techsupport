# Copy to .env and fill in real values. Never commit .env.
# Every optional variable's default lives in src/lib/config.ts — this file
# documents what exists, not every knob you are expected to set.

# ── Required · Jira Service Management ────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@your-org.com
JIRA_API_TOKEN=your-jira-api-token
# Must be project-scoped outside dry-run. The unscoped fallback is dry-run only.
JIRA_JQL=project = DC AND statusCategory != Done AND assignee is not EMPTY ORDER BY priority DESC, updated ASC
# Names must match the JSM metrics exactly. First response decides whether to
# remind; resolution is the L2-L5 escalation clock in docs/sla-matrix.md.
JIRA_FIRST_RESPONSE_SLA_NAME=Time to first response
JIRA_RESOLUTION_SLA_NAME=Time to resolution
# Custom field holding Request participants — the people expected to act on a
# request, as opposed to the support team that triages it. The id differs per
# Jira instance; find yours with GET /rest/api/3/field.
JIRA_PARTICIPANTS_FIELD=customfield_10065

# ── Required · at least one Teams transport ───────────────────────────────────
# Personal bot: direct messages plus contract escalation.
# This file is tracked and the repository is public, so it carries no real
# address or tenant identifier — the same reason config/escalation.json is
# gitignored. The deployed values live in the repository variables and in your
# own untracked .env.
# TEAMS_BOT_APP_ID is the Entra application id of the bot's app registration,
# and doubles as the manifest id of the Teams app package.
TEAMS_BOT_APP_ID=
TEAMS_BOT_TENANT_ID=
# Local runs only. In GitHub Actions prefer the OIDC federated credential and
# leave this unset; set it as a repository secret only if OIDC is unavailable.
TEAMS_BOT_APP_PASSWORD=
# Channel webhook: one aggregated post, no escalation. Optional and independent
# of the bot — either transport alone is a working deployment.
# TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/...

# ── Rollout controls ─────────────────────────────────────────────────────────
# Fetch and select without sending anything. Logs counts only, never identities.
# REMINDER_DRY_RUN=false

# While set, nobody outside this list can be messaged, whatever the escalation
# directory says. Matched by email, directory handle, or object id; an entry
# that matches nobody is an error, not a gate that silently delivers nothing.
# TEAMS_BOT_RECIPIENT_ALLOWLIST=first.pilot@your-org.com,second.pilot@your-org.com

# One-time step before the first live run: record every level already crossed
# and notify nobody, so the backlog is not delivered all at once.
# ESCALATION_SEED_ONLY=false

# ── Escalation directory and state ───────────────────────────────────────────
# Who each contractual level is. Copy config/escalation.example.json, fill in
# email and jiraAccountId, then run `npm run resolve:ids`.
# ESCALATION_CONFIG_FILE=config/escalation.json
# ESCALATION_STATE_FILE=.escalation-state/state.json

# ── Rarely needed · Graph and catalog ────────────────────────────────────────
# Delivery asks Graph to install the app for the recipient and hand back their
# personal chat id, then posts one activity through the Bot Connector. Graph
# therefore needs these application permissions, with admin consent:
#   AppCatalog.Read.All                            find the app in the catalog
#   TeamsAppInstallation.ReadWriteSelfForUser.All  install this app for a person
#     (fall back to TeamsAppInstallation.ReadWriteForUser.All if refused)
#   User.Read.All                                  only for `npm run resolve:ids`;
#     not needed if object ids are read from the Azure portal instead
#
# Graph credentials default to the bot's own registration; override only if
# Graph lives on a separate app. TEAMS_APP_EXTERNAL_ID defaults to
# TEAMS_BOT_APP_ID and only differs if the published manifest id differs.
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# TEAMS_APP_EXTERNAL_ID=
# TEAMS_BOT_SERVICE_URL=https://smba.trafficmanager.net/teams

# ── Rarely needed · tuning ───────────────────────────────────────────────────
# Delivery window. Set equal to each other, the schedule is the cadence and
# every eligible breach is reminded on every run — which is the deployed
# configuration, because the workflow runs twice a working day. Set the window
# narrower only if the workflow runs far more often than a reminder should be
# sent, and then check the interaction: if the gap between runs is a whole
# multiple of the repeat interval, `elapsed % repeat` never changes and
# whichever breaches start outside the window stay outside it forever.
# REMINDER_REPEAT_MINUTES=60
# REMINDER_DELIVERY_WINDOW_MINUTES=60
# Pagination, concurrency and request caps. Defaults are sized for a service
# desk and are only worth changing if a run hits one of them.
# JIRA_PAGE_SIZE / JIRA_MAX_RESULTS / JIRA_MAX_SEARCH_PAGES
# JIRA_SLA_PAGE_SIZE / JIRA_MAX_SLA_PAGES / JIRA_SLA_CONCURRENCY
# TEAMS_MAX_MESSAGE_CHARS / HTTP_TIMEOUT_MS / HTTP_MAX_RETRIES

# ── Optional · model-written opening line ────────────────────────────────────
# Affects the channel post's first sentence only, so it does nothing in a
# bot-only deployment. The model receives aggregate counts and never any Jira
# content. Enabling it needs Vertex AI credentials in the environment
# (GOOGLE_CLOUD_PROJECT, GOOGLE_CLOUD_LOCATION, and ADC or a key file).
# REMINDER_USE_LLM_INTRO=false
# REMINDER_INTRO_TIMEOUT_MS=10000
